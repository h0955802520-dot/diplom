# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (uncomment for Postgres; leave commented for SQLite fallback)
# DATABASE_URL=postgres://budmaster:budmaster@db:5432/budmaster

# CORS — потрібно ЛИШЕ якщо API розгорнуто на іншому домені, ніж фронт.
# При інтегрованому розгортанні (один процес Django подає і фронт, і API)
# можна лишити порожнім.
CORS_ALLOWED_ORIGINS=

# JWT
JWT_ACCESS_LIFETIME_MIN=60
JWT_REFRESH_LIFETIME_DAYS=7
